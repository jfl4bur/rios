# Firebase service account
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
# Or set these:
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=...
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Server port (overridden by config/config.json)
PORT=9000

### Cleanup/notification SMTP (optional)
# Example configuration to enable email notifications from cleanup_uploads
# Use a dedicated SMTP account or service (recommended). For Gmail, prefer an App Password.
CLEANUP_ENABLE_EMAIL=1
CLEANUP_SMTP_HOST=smtp.example.com
CLEANUP_SMTP_PORT=587
CLEANUP_SMTP_SECURE=0 # 1=true (TLS), 0=false
CLEANUP_SMTP_USER=notify@example.com
CLEANUP_SMTP_PASS=supersecret
CLEANUP_NOTIFY_TO=ops@example.com
# If using Gmail and an App Password: set CLEANUP_ALLOW_GMAIL_APP_PASS=1 (opt-in)
# CLEANUP_ALLOW_GMAIL_APP_PASS=1
