# Optional notification env for run_cleanup.bat
# Place this file at backend\cleanup-notify.env and set values as needed.
# Lines starting with # are comments. Format: KEY=VALUE

# Enable email notifications (1 to enable)
CLEANUP_ENABLE_EMAIL=1

# SMTP settings (only required if CLEANUP_ENABLE_EMAIL=1)
# Replace the values below with your SMTP host/user and, importantly, your SMTP password
# KEEP THE PASSWORD SECRET. Do NOT paste passwords in chat.
CLEANUP_SMTP_HOST=smtp.example.com
CLEANUP_SMTP_PORT=587
CLEANUP_SMTP_SECURE=0
CLEANUP_SMTP_USER=notify@example.com
# Replace the following placeholder with the actual SMTP password locally
CLEANUP_SMTP_PASS=REPLACE_ME_WITH_SMTP_PASSWORD
CLEANUP_SMTP_FROM=rios-notify@example.com

# Comma-separated recipients
CLEANUP_NOTIFY_TO=ops@example.com,admin@example.com

# Webhook URL alternative (optional)
# CLEANUP_WEBHOOK_URL=https://hooks.example.com/rios-cleanup

# For Gmail App Passwords (set to 1 if you are using an App Password)
# If you use Gmail, generate an App Password and set the flag below
CLEANUP_ALLOW_GMAIL_APP_PASS=0

# Minimum interval (minutes) between notifications with identical payload (default 15)
CLEANUP_NOTIFY_MIN_INTERVAL_MIN=60

# Notes:
# - Use the helper script backend\scripts\setup_notify_smtp.ps1 to write this file interactively and
#   keep the password secured on your machine.
# - After replacing CLEANUP_SMTP_PASS locally, run the SMTP test:
#     pwsh -NoProfile -Command "node 'backend\scripts\test_smtp_send.js'"
