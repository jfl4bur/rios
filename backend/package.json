{
  "name": "rios-backend",
  "version": "0.1.0",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "test": "node --test ./tests/index.test.js",
    "test:env": "node tests/test_env_loader.js",
    "test:smtp": "node scripts/test_smtp_send.js",
    "check": "pwsh -NoProfile -File scripts/run_all_checks.ps1",
    "migrate": "node scripts/run_migrations.js",
    "migrate:ps1": "pwsh -NoProfile -File scripts/run_migrations.ps1 -DbPath \"backend/data.sqlite\" -RunPostScripts",
    "seed:demo": "node seeds/demo.js",
    "cleanup:uploads": "node scripts/cleanup_uploads.js",
    "create-test-db": "node scripts/create_test_db.js",
    "start-dummy-server": "node scripts/start_dummy_server.js",
  "test:local": "npm run create-test-db && npm test",
  "test:local:all": "node scripts/test_local_all.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "exif-parser": "^0.1.12",
    "express": "^4.18.2",
    "firebase-admin": "^13.4.0",
    "form-data": "^4.0.4",
    "joi": "^17.9.2",
    "multer": "^1.4.5-lts.1",
    "node-fetch": "^2.7.0",
    "nodemailer": "^6.10.1",
    "sharp": "^0.32.1",
    "sqlite3": "^5.1.6",
  "pg": "^8.10.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.10"
  }
}
